<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration
  Server now supports HTTPS - cleartext kept for local development only.
-->
<network-security-config>
    <!-- Base config - allow cleartext for local development -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow HTTPS for Supabase -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">supabase.co</domain>
        <domain includeSubdomains="true">lwplbyltqsfmfvsgmrjq.supabase.co</domain>
    </domain-config>

    <!-- Allow HTTP for specific domains only -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Production API (no SSL currently) -->
        <domain includeSubdomains="true">api.truckast.ai</domain>
        <domain includeSubdomains="true">truckast.ai</domain>

        <!-- Local development -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.3.2</domain>
        <domain includeSubdomains="true">192.168.1.10</domain>
    </domain-config>
</network-security-config>

{
  "name": "TruckApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start --reset-cache",
    "start:dev": "APP_ENV=development react-native start --reset-cache",
    "start:prod": "APP_ENV=production react-native start --reset-cache",
    "android": "react-native run-android",
    "android:dev": "APP_ENV=development react-native run-android",
    "android:prod": "APP_ENV=production react-native run-android --mode=release",
    "ios": "react-native run-ios",
    "ios:dev": "APP_ENV=development react-native run-ios",
    "ios:prod": "APP_ENV=production react-native run-ios --mode=Release",
    "build:android:dev": "APP_ENV=development cd android && ./gradlew assembleDebug",
    "build:android:prod": "APP_ENV=production cd android && ./gradlew assembleRelease",
    "build:android:bundle": "APP_ENV=production cd android && ./gradlew bundleRelease",
    "clean": "watchman watch-del-all && rm -rf node_modules/.cache && rm -rf $TMPDIR/metro-* && rm -rf $TMPDIR/haste-map-*",
    "clean:android": "cd android && ./gradlew clean",
    "clean:ios": "cd ios && rm -rf build && rm -rf ~/Library/Developer/Xcode/DerivedData",
    "clean:all": "npm run clean && npm run clean:android && npm run clean:ios",
    "prebuild:prod": "npm run clean",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-firebase/app": "^23.8.4",
    "@react-native-firebase/messaging": "^23.8.4",
    "@react-native/new-app-screen": "0.83.1",
    "@react-navigation/bottom-tabs": "^7.9.1",
    "@react-navigation/material-top-tabs": "^7.4.12",
    "@react-navigation/native": "^7.1.27",
    "@react-navigation/native-stack": "^7.9.1",
    "@react-navigation/stack": "^7.6.14",
    "@rnmapbox/maps": "^10.2.10",
    "@sentry/react-native": "^7.11.0",
    "@supabase/supabase-js": "^2.93.2",
    "@tanstack/react-query": "^5.90.17",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "i18next": "^25.7.4",
    "moment": "^2.30.1",
    "react": "19.2.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.3",
    "react-native": "0.83.1",
    "react-native-bootsplash": "^6.3.12",
    "react-native-calendars": "^1.1313.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "^3.6.1",
    "react-native-mmkv": "^2.12.2",
    "react-native-pager-view": "^8.0.0",
    "react-native-paper": "^5.14.5",
    "react-native-permissions": "^5.4.4",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.19.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-sound": "^0.13.0",
    "react-native-svg": "^15.15.1",
    "react-native-tab-view": "^4.2.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "^0.7.1",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.2",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}

# Environment Configuration Template
# Copy this file to .env.development, .env.staging, or .env.production

# API Configuration
# Development: Use your local server IP
# Production: Use HTTPS URL only!
API_BASE_URL=https://api.example.com/api
API_TIMEOUT=30000

# Federated Auth URL (admin server for tenant-based login)
FEDERATED_AUTH_URL=https://admin.truckast.ai/api

# App Environment (development | staging | production)
APP_ENV=development

# Mapbox Access Token
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Sentry Error Tracking
# Get your DSN from https://sentry.io -> Project Settings -> Client Keys (DSN)
SENTRY_DSN=your_sentry_dsn_here
